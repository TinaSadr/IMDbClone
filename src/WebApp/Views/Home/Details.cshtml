@model WebApp.Models.Movie

@{
    ViewData["Title"] = Model.Title;
}

<div class="movie-details">

    <div class="details-poster">
        @if (!string.IsNullOrWhiteSpace(Model.PosterPath))
        {
            <img
                src="https://image.tmdb.org/t/p/w500@(Model.PosterPath)"
                alt="@Model.Title poster" />
        }
        else
        {
            <div class="poster-placeholder">
                🎬
            </div>
        }
    </div>

    <div class="details-content">

        <h1>@Model.Title</h1>

        @if (!string.IsNullOrWhiteSpace(Model.Tagline))
        {
            <p class="tagline">@Model.Tagline</p>
        }

        <div class="rating">
            ⭐ @Model.VoteAverage.ToString("0.0")
            <span>(@Model.VoteCount votes)</span>
        </div>

        <div class="movie-meta">
            @if (Model.ReleaseDate.HasValue)
            {
                <span>@Model.ReleaseDate.Value.Year</span>
            }

            @if (Model.Runtime.HasValue)
            {
                <span>@Model.Runtime min</span>
            }

            @if (!string.IsNullOrWhiteSpace(Model.OriginalLanguage))
            {
                <span>@Model.OriginalLanguage.ToUpper()</span>
            }
        </div>

        <h2>Overview</h2>

        <p class="overview">
            @Model.Overview
        </p>

        @if (!string.IsNullOrWhiteSpace(Model.Genres))
        {
            <h2>Genres</h2>

            <p class="genres">
                @Model.Genres
            </p>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Keywords))
        {
            <h2>Keywords</h2>

            <p class="genres">
                @Model.Keywords
            </p>
        }

    </div>

</div>